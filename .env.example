DISCORD_TOKEN=your-bot-token
DISCORD_CHANNEL_ID=123456789012345678
SUNNY_SUNDAY_CHANNEL_ID=123456789012345678
OPENAI_API_KEY=your-openai-api-key
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# 메인 서버가 직접 수집할 월드 ID. 비우면 주요 4개 월드를 모두 수집합니다.
# RANKING_WORLD_IDS=45
# RANKING_INBOX_PATH=ranking-inbox

# 별도 IP의 보조 수집기에서만 설정합니다.
# RANKING_WORKER_WORLD_IDS=19,1,70
# RANKING_WORKER_NAME=oracle-worker-2
# RANKING_WORKER_DB_PATH=ranking-worker.db
# RANKING_OUTBOX_PATH=ranking-outbox
# RANKING_BATCH_PAGES=60
# RANKING_SYNC_TARGET=ubuntu@main-server:/home/ubuntu/maplestory-discord-bot/ranking-inbox/
# RANKING_SYNC_SSH_KEY=/home/ubuntu/.ssh/ranking-sync
